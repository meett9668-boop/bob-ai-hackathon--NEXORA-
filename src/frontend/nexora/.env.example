# ============================================================
# NEXORA Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is already in .gitignore.
#
# For Vite: all variables exposed to the browser must start with VITE_

# ── Google Identity Services (real Google Sign-In) ─────────
# Create a Google OAuth 2.0 Client ID at:
#   https://console.cloud.google.com/apis/credentials
# Set authorized JavaScript origins to:
#   http://localhost:5173  (development)
#   https://your-deployed-domain.vercel.app  (production)
VITE_GOOGLE_CLIENT_ID=

# ── Google Maps JavaScript API ─────────────────────────────
# Create a Maps API key at:
#   https://console.cloud.google.com/apis/credentials
# Restrict the key to:
#   - Maps JavaScript API
#   - (optional) Places API
#   - HTTP referrers: localhost:5173/*, your-domain.com/*
VITE_GOOGLE_MAPS_API_KEY=

# ── OpenWeatherMap API (live weather data) ───────────────────
# Free tier available at: https://openweathermap.org/api
# Without this key, the Weather page uses NEXORA demo weather data.
VITE_WEATHER_API_KEY=

# ── API base URL (leave empty to use Vite proxy to localhost:8000) ──
VITE_API_BASE_URL=
