# ============================================================
# NEXORA Backend — Environment Variables
# ============================================================
# Copy this file to src/backend/.env and fill in values as needed.
# NEVER commit the .env file - it is already in .gitignore.

# --- Application ---
APP_PORT=8000
APP_ENV=development

# --- Google Authentication (server-side token verification) ---
# Required for /api/auth/google endpoint.
# Create a Google OAuth 2.0 Client ID at:
#   https://console.cloud.google.com/apis/credentials
# Must match the VITE_GOOGLE_CLIENT_ID in the frontend .env
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET is only required if you implement
# server-side OAuth2 code flow. For GIS (credential callback) flow,
# only the client ID is needed.
GOOGLE_CLIENT_SECRET=

# --- IBM watsonx.ai (optional - leave blank to use local advisory engine) ---
# Required only for the AI Failure Advisor IBM integration.
# When not set, the local deterministic advisory engine is used instead.
# The UI clearly indicates which provider is active.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
